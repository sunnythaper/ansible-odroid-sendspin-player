[Unit]
Description=Sendspin TUI player on tty1
Wants=network-online.target
After=network-online.target sound.target hifishield2-init.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User={{ sendspin_daemon_user }}
SupplementaryGroups=audio
Environment=TERM=linux
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYReset=yes
TTYVHangup=yes
ExecStart={{ sendspin_daemon_home }}/.local/bin/sendspin
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
CapabilityBoundingSet=
RemoveIPC=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@clock @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
MemoryDenyWriteExecute=yes
ProtectProc=invisible
ProcSubset=pid
IPAddressDeny=any
IPAddressAllow={{ sendspin_server_url | urlsplit('hostname') }}
PrivateDevices=yes
DeviceAllow=char-alsa rwm
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
