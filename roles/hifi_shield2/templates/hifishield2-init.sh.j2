#!/bin/sh
set -eu

card=$(aplay -l 2>/dev/null | sed -n '/HDMI/!s/^card \([0-9][0-9]*\):.*/\1/p' | head -n 1)

if [ -z "$card" ]; then
    echo "No HiFi Shield 2 compatible card found" >&2
    exit 0
fi

amixer -c "$card" sset "Digital Playback Volume" 201 >/dev/null 2>&1 || true
amixer -c "$card" sset "Analogue Playback Volume" 0 >/dev/null 2>&1 || true
amixer -c "$card" sset "Deemphasis Switch" on >/dev/null 2>&1 || true