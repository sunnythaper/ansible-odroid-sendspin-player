/dts-v1/;
/plugin/;

/ {
	compatible = "hardkernel,odroid-c2", "amlogic,meson-gxbb";

	fragment@0 {
		target-path = "/sound";
		__overlay__ {
			status = "disabled";
		};
	};

	fragment@1 {
		target = <&i2c_A>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;

			pcm5242: pcm5242@4c {
				compatible = "ti,pcm5242";
				reg = <0x4c>;
				#sound-dai-cells = <0>;
			};
		};
	};
{% if sendspin_enable_spdif %}
	fragment@2 {
		target-path = "/";
		__overlay__ {
			spdif_dit: spdif-dit {
				#sound-dai-cells = <0>;
				compatible = "linux,spdif-dit";
				sound-name-prefix = "DIT";
			};
		};
	};
{% endif %}
	fragment@3 {
		target = <&aiu>;
		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&spdif_out_ao_6_pins &i2s_am_clk_pins &i2s_out_ao_clk_pins &i2s_out_lr_clk_pins &i2s_out_ch01_ao_pins>;
		};
	};

	fragment@4 {
		target-path = "/";
		__overlay__ {
			sound-hifishield2 {
				compatible = "amlogic,gx-sound-card";
				model = "ODROID-HiFiShield2";

				clocks = <&clkc 13>, <&clkc 14>, <&clkc 15>;
				assigned-clocks = <&clkc 13>, <&clkc 14>, <&clkc 15>;
				assigned-clock-rates = <294912000>, <270950400>, <393216000>;

				dai-link-0 {
					sound-dai = <&aiu 0 0>;
				};
{% if sendspin_enable_spdif %}
				dai-link-1 {
					sound-dai = <&aiu 0 1>;
				};
{% endif %}
				dai-link-2 {
					sound-dai = <&aiu 0 2>;
					dai-format = "i2s";
					mclk-fs = <256>;

					codec-0 {
						sound-dai = <&pcm5242>;
					};
				};
{% if sendspin_enable_spdif %}
				dai-link-3 {
					sound-dai = <&aiu 0 3>;

					codec-0 {
						sound-dai = <&spdif_dit>;
					};
				};
{% endif %}
			};
		};
	};
};